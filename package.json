{
  "name": "@chonwai/dsh-gsap-skills",
  "version": "1.0.4",
  "private": true,
  "description": "GreenSock's official GSAP skills packaged as an unofficial DeepSeek Harness bundle (eight skills, no runtime scripts).",
  "license": "MIT",
  "author": "Chonwai",
  "keywords": [
    "gsap",
    "greensock",
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "ai-skills",
    "agent-skills",
    "animation"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bash tests/offline-check.sh",
    "check": "node --check lib/index.js && node --check tests/host-smoke.mjs && node --check tests/registry-smoke.mjs && node --check tools/apply-corrections.mjs && node --check tests/demo-smoke.mjs && node --check tests/prompt-contract.mjs",
    "smoke": "node tests/host-smoke.mjs && node tests/registry-smoke.mjs && node tests/demo-smoke.mjs",
    "registry-smoke": "node tests/registry-smoke.mjs",
    "corrections-check": "node tools/apply-corrections.mjs --check",
    "smoke:demo": "node tests/demo-smoke.mjs",
    "prompt-contract": "node tests/prompt-contract.mjs demo"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/**/*.js",
    "skills",
    "docs",
    "tests",
    "patches",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-TW.md",
    "INSTALL.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "checksums.txt",
    "provenance.json",
    "tools",
    "demo",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
